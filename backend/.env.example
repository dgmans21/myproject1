# 복사 후 사용 (Windows)
#   copy .env.example .env
# macOS/Linux
#   cp .env.example .env
#
# Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Kakao Developers → REST API 키 (백엔드 이동시간 Mobility)
KAKAO_REST_API_KEY=

# 네이버 로그인 (개발자센터). Callback = FastAPI:
#   http://localhost:8000/api/v1/auth/naver/callback
#   http://<LAN-IP>:8000/api/v1/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 쉼표로 여러 origin (localhost). LAN 대역은 CORS_LAN_PREFIX 사용.
# IP 변경 시: .\scripts\set-lan-ip.ps1 -Ip 192.168.0.10
# 아래 192.168.0.10 / 192.168.0 은 문서용 가짜 예시 — 실값은 스크립트가 .env 에만 씀
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 같은 /24 의 .100~.250:3000 을 CORS·네이버 frontend_origin 허용에 자동 추가
CORS_LAN_PREFIX=192.168.0
